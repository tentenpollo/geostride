# ==============================================================================
# GeoStride Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Generic LLM Integration (Optional, used for natural language parsing if needed)
LLM_PROVIDER=openai # openai, anthropic, or local
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=

# Session Management
# How long (in seconds) sessions should be kept in memory
SESSION_TTL_SECONDS=3600

# Graph Caching
# Directory to store OSM caches
CACHE_DIR=./data/cache

# Constants
WALKING_SPEED_KMH=4.5
